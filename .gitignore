# virtual environment - never commit this (huge, machine-specific)
venv/

# environment variables - NEVER commit this (contains your API keys)
.env

# chromadb vector store - large binary files, regenerated by ingest.py
chroma_db/

# python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# vs code settings
.vscode/

# documents folder (PDFs can be large, store elsewhere)
documents/

# os junk
.DS_Store
Thumbs.db

# test/temp files
*.log
*.tmp